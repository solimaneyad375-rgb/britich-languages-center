# British Center for Languages - Backend Environment Configuration
# Copy this file to .env and configure your private credentials
# NEVER COMMIT .env TO VERSION CONTROL

PORT=5000
NODE_ENV=development

# 64+ Character Cryptographic Secret for JWT Session Signing
JWT_SECRET=bcl_sec_prod_99f2a71d8e034b5c871239aa8e45f910cd34891bca726ef3104928bcefa12390
JWT_EXPIRES_IN=24h

# Private Administrator Provisioning Credentials
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD="12345"
# Alternatively, specify a pre-hashed bcrypt string (cost factor 12):
# ADMIN_PASSWORD_HASH=

# Cookie & CORS Security
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://solimaneyad375-rgb.github.io
